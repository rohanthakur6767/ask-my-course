# Ask My Course - backend environment
# Copy this file to ".env" and fill in your values. Never commit the real .env.

# --- Database ---
# Use "localhost" for a locally installed Postgres, or "db" when running
DB_NAME=ask_my_course
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# For a managed database like Supabase, also set:
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=600

# --- AI provider: Google Gemini (free tier), used via its OpenAI-compatible API ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# --- DOCX/PPTX -> PDF conversion (for "open at exact page/slide") ---
# LibreOffice is auto-detected on PATH and common install paths. Only set this
# if it lives somewhere unusual, e.g.:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# --- Cloud file storage (optional): Supabase Storage ---
# Set these to make the citation "Open"/"Download" links work on the deployed
# site (not just localhost). Create a PUBLIC bucket named "course-files" in your
# Supabase project (Storage tab). The service_role key is secret: server only,
# never the frontend. Leave all three blank locally to serve files from /media/.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...          # the secret key (server only, keep out of git)
# SUPABASE_BUCKET=course-files

# --- Production only (leave unset for local dev) ---
# DEBUG=False
# SECRET_KEY=generate-a-long-random-string
# ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ORIGINS=https://your-frontend.pages.dev
