# Ask My Course - backend environment
# Copy this file to ".env" and fill in your values. Never commit the real .env.

# --- Database ---
# Use "localhost" for a locally installed Postgres, or "db" when running
# through docker compose (that is the database service name).
DB_NAME=ask_my_course
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# --- OpenAI (required) ---
# Used for embeddings (text-embedding-3-small) and answers (gpt-4o-mini).
OPENAI_API_KEY=your_openai_key_here
