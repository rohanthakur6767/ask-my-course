# Ask My Course - backend environment
# Copy this file to ".env" and fill in your values. Never commit the real .env.

# --- Database ---
# Use "localhost" for a locally installed Postgres, or "db" when running
# through docker compose (that is the database service name).
DB_NAME=ask_my_course
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# --- OpenAI ---
# Leave OPENAI_API_KEY blank and keep the two flags "true" to run fully offline
# with deterministic fake embeddings and a stub answer.
# When you have a key: paste it here and set both flags to "false", then re-ingest.
OPENAI_API_KEY=
USE_FAKE_EMBEDDINGS=true
USE_FAKE_LLM=true
